      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "${USER_UUID}",
            "email": "shared_legacy",
            "level": 0
          },
          {
            "id": "${USER_UUID}",
            "email": "user_USER_TOKEN_21",
            "level": 0
          },
          {
            "id": "${VLESS_UUID}",
            "email": "user_USER_TOKEN_22",
            "level": 0
          },
